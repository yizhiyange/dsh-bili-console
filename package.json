{
  "name": "dsh-bili-console",
  "version": "0.3.22",
  "description": "DSH 插件：刷B站 · 双模控制台 —— 每天替你刷一轮 B站，读字幕挑值得的、写日报；网页控制台 + DSH 设置界面双操控，一个包装着两边",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bilibili",
    "mcp",
    "console",
    "duty"
  ],
  "license": "MIT",
  "author": "一只炎鸽 (yizhiyange)",
  "homepage": "https://github.com/yizhiyange/dsh-bili-console",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "prompts",
    "web",
    "vendor",
    "README.md",
    "ARCHITECTURE.md",
    "AGENTS.md",
    "selfcheck.mjs",
    "LICENSE",
    "NOTICE.md"
  ],
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
