# DSH 插件 .gitignore

# 依赖
node_modules/

# Python 缓存
__pycache__/
*.pyc
*.pyo
.venv/

# 敏感凭证（绝不上传！）
bili_credential.json
*.credential.json
credentials.yaml
*.credentials.yaml
# 插件运行数据（里面有 models[].customKey 明文 API Key）
config.json
config.local.json
_apitest_home/
# 但示例配置可以传
!config.example.json

# 系统文件
.DS_Store
Thumbs.db

# 临时文件
*.log
*.tmp

# 调试 / 测试草稿（不进仓库）
.video/
_autopublish_test.mjs
_check_at.py
_live_state.json
_live_state.mjs
_login_test.mjs
_real_probe.mjs
_sync_standalone.mjs
_t2.mjs
_ui_harness.html
_ui_probe.mjs
_verify_login.py
_verify_split.mjs
_web_test.mjs
_web3.png
client.js.bak-*
index.js.bak-*
prompts/duty.md.bak-*
qrcode_login_stable.png
vendor/bilibili-mcp/login_debug.json
