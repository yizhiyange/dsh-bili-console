# DSH 插件 .gitignore

# 依赖
node_modules/

# Python 缓存
__pycache__/
*.pyc
*.pyo
.venv/

# 敏感凭证（绝不上传！）
bili_credential.json
*.credential.json
credentials.yaml
*.credentials.yaml
# 插件运行数据（里面有 models[].customKey 明文 API Key）
config.json
config.local.json
_apitest_home/
# 但示例配置可以传
!config.example.json

# 系统文件
.DS_Store
Thumbs.db

# 临时文件
*.log
*.tmp
